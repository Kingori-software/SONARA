<!-- ===========================================================
     index.html
     SONORA — Main HTML structure
     ============================================================ -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SONORA — Find the right sound</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="style.css" />
</head>
<body>

    <div class="app-container" id="app">

        <!-- ===== HEADER ===== -->
        <header class="header">
            <div class="logo-area">
                <span class="logo-icon">♫</span>
                <span class="logo-text">SONORA</span>
            </div>

            <nav class="nav-links">
                <button class="nav-link active" data-view="home"><i class="fas fa-home"></i> Home</button>
                <button class="nav-link" data-view="categories"><i class="fas fa-th-large"></i> Categories</button>
                <button class="nav-link" data-view="favorites"><i class="fas fa-heart"></i> Favorites <span class="badge" id="favCount">0</span></button>
            </nav>

            <div class="search-wrapper">
                <i class="fas fa-search"></i>
                <input class="search-input" id="globalSearch" type="text" placeholder="Search songs, artists, moods…" />
            </div>
        </header>

        <!-- ===== HERO ===== -->
        <section class="hero">
            <h1>Find the right sound for every moment.</h1>
            <p>Explore <span id="totalCategories">20</span> categories and <span id="totalSongs">0</span> songs curated by mood, theme, and vibe.</p>
        </section>

        <!-- ===== VIEW: HOME ===== -->
        <div class="view active" id="view-home">
            <div class="category-grid" id="categoryGrid"></div>
        </div>

        <!-- ===== VIEW: CATEGORY ===== -->
        <div class="view" id="view-category">
            <div class="category-header" id="categoryHeader">
                <div class="category-header-left">
                    <span class="big-emoji" id="catEmoji">💜</span>
                    <div>
                        <div class="cat-title" id="catTitle">Love & Romance</div>
                        <div class="cat-sub" id="catDesc">The best songs for love, romance and everything in between.</div>
                    </div>
                </div>
                <div class="category-controls">
                    <button class="btn-back" id="backHomeBtn"><i class="fas fa-arrow-left"></i> Back</button>
                    <select class="sort-select" id="sortSelect">
                        <option value="rating">⭐ Highest Rated</option>
                        <option value="recent">🕐 Recently Added</option>
                        <option value="az">A–Z</option>
                    </select>
                </div>
            </div>
            <div class="song-grid" id="songGrid"></div>
        </div>

        <!-- ===== VIEW: FAVORITES ===== -->
        <div class="view" id="view-favorites">
            <div style="padding: 8px 0 20px;">
                <h2 style="font-size:28px; font-weight:700; letter-spacing:-0.5px;">❤️ Your Favorites</h2>
                <p style="color:var(--text-secondary);">All the songs you've saved.</p>
            </div>
            <div class="song-grid" id="favGrid"></div>
        </div>

        <!-- ===== VIEW: SEARCH RESULTS ===== -->
        <div class="view" id="view-search">
            <div style="padding: 8px 0 20px;">
                <h2 style="font-size:28px; font-weight:700; letter-spacing:-0.5px;">🔍 Search Results</h2>
                <p style="color:var(--text-secondary);" id="searchResultInfo">0 songs found</p>
            </div>
            <div class="song-grid" id="searchGrid"></div>
        </div>

        <!-- ===== MODAL ===== -->
        <div class="modal-overlay" id="modalOverlay">
            <div class="modal" id="modalContent">
                <button class="modal-close" id="modalCloseBtn">&times;</button>
                <span class="modal-emoji" id="modalEmoji">🎵</span>
                <div class="modal-title" id="modalTitle">Song Name</div>
                <div class="modal-artist" id="modalArtist">Artist</div>
                <div style="margin-top:16px;">
                    <div class="modal-detail-row"><span class="modal-label">Genre</span><span class="modal-value" id="modalGenre">—</span></div>
                    <div class="modal-detail-row"><span class="modal-label">Categories</span><span class="modal-value" id="modalCategories">—</span></div>
                    <div class="modal-detail-row"><span class="modal-label">Moods</span><span class="modal-value"><span class="modal-moods" id="modalMoods"></span></span></div>
                    <div class="modal-detail-row"><span class="modal-label">Theme Rating</span><span class="modal-value" id="modalRating">—</span></div>
                    <div class="modal-detail-row"><span class="modal-label">Date Added</span><span class="modal-value" id="modalDate">—</span></div>
                </div>
                <div class="modal-notes" id="modalNotes"><strong>Notes:</strong> No personal notes yet.</div>
                <button class="modal-fav-btn" id="modalFavBtn"><i class="fas fa-heart"></i> Add to Favorites</button>
            </div>
        </div>

    </div>

    <script src="script.js"></script>
</body>
</html>